generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GameStatus {
  BACKLOG
  PLAYING
  COMPLETED
  DROPPED
  PAUSED
}

enum PriorityTag {
  MAYBE_SOMEDAY
  FAVORITE
  MUST_PLAY
  DONE
}

model Game {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  // Tu data "manual" mínima (por si IGDB falla o querés customizar)
  title          String
  releaseYear    Int?
  estimatedHours Int?
  personalNote   String?

  status   GameStatus  @default(BACKLOG)
  priority PriorityTag @default(MAYBE_SOMEDAY)

  // Integración IGDB (clave)
  igdbId     Int?     @unique
  summary    String?
  developers String[] @default([])
  coverUrl   String?
  heroUrl    String?

  // Tienda/plataforma (texto libre por ahora)
  store String? // "Steam", "Epic", "Xbox", etc.

  // Orden "Play next" (null si no está en la cola)
  queuePosition Int? @unique

  activities GameActivity[]

  @@index([title])
  @@index([status])
  @@index([priority])
}

model GameActivity {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  type      String
  detail    String?
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId, createdAt])
}
